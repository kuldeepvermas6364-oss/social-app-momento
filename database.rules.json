{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'username', 'displayName', 'bio', 'createdAt', 'updatedAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "avatarUrl": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && newData.val().length <= 2048)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "privateUsers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && $username.matches(/^[a-z0-9_]{3,20}$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid)"
      }
    }
  }
}
