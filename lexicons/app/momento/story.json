{
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "app.momento.story",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A public, short-lived Momento photo or video story. Clients should hide the record at or after expiresAt; stories are intended to expire 24 hours after createdAt.",
      "record": {
        "type": "object",
        "required": [
          "media",
          "mediaType",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "media": {
            "type": "blob",
            "accept": [
              "image/*",
              "video/mp4"
            ],
            "maxSize": 100000000,
            "description": "The image or MP4 video attached to this story."
          },
          "mediaType": {
            "type": "string",
            "knownValues": [
              "image",
              "video"
            ],
            "description": "The media kind; must match the uploaded blob MIME type."
          },
          "caption": {
            "type": "string",
            "maxLength": 300,
            "maxGraphemes": 300,
            "description": "Optional short story caption."
          },
          "altText": {
            "type": "string",
            "maxLength": 1000,
            "description": "Accessibility description for image stories."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime",
            "description": "Client-enforced expiry timestamp, normally createdAt plus 24 hours."
          }
        }
      }
    }
  }
}
